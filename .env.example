# Proton Pass references only (vault "Stash"); never put real values here.
# Copy to .env (gitignored) and run: PROTON_PASS_AGENT_REASON="<reason>" pp run --env-file .env -- <cmd>
ANTHROPIC_API_KEY=pass://Stash/Anthropic/api_key
# Workers AI embeddings smoke test (`smoke:embed`, docs/enrichment-smoke.md) and deploys.
CLOUDFLARE_ACCOUNT_ID=pass://Stash/Cloudflare/account_id
CLOUDFLARE_API_TOKEN=pass://Stash/Cloudflare/api_token

# Not a secret: the one GitHub login allowed to sign in. Stage `prod` defaults to the owner's
# committed login, other deployed stages require it (docs/deploy.md); `alchemy dev` uses `dev_only`.
# STASH_ALLOWED_GITHUB_LOGIN=

# Not a secret: the hostname a deployed stage is served on (the web app, `/api` and `/mcp`), in a
# zone of the Cloudflare account. Stage `prod` uses the committed hostname from alchemy.run.ts;
# other stages stay on workers.dev unless this is set (docs/deploy.md#custom-domain).
# STASH_DOMAIN=

# `pnpm dev:api` (alchemy dev) needs none of these. Alchemy auto-loads this .env, but the shell
# environment wins, so run deploys through `pp run` and never pass `--env-file .env` to alchemy.
# See docs/alchemy.md.

# Not a secret: extra hosts (comma-separated) the web dev/preview server accepts, for opening
# `pnpm dev:web` by hostname from another machine. Unset keeps Vite's default. See apps/web/CLAUDE.md.
# STASH_DEV_ALLOWED_HOSTS=

# Not a secret: the GitHub OAuth app's client id. The Device Flow login needs no client secret, so
# nothing about GitHub goes to Proton Pass. `alchemy dev` uses the placeholder `dev_only`; stage
# `prod` uses the committed id from alchemy.run.ts. Set it only to override (docs/deploy.md).
# GITHUB_CLIENT_ID=

# Planned: Sign in with Google (#178). An OAuth web client of the project in Google Cloud; its
# redirect URI is https://<domain>/api/auth/google/callback (docs/deploy.md#google-sign-in).
# Without both, the Google button is hidden and its routes answer 503; passkeys and GitHub work.
# GOOGLE_CLIENT_ID=pass://Stash/Google/client_id
# GOOGLE_CLIENT_SECRET=pass://Stash/Google/client_secret

# Planned: signs the Zen / Firefox extension on deploy as an unlisted add-on (Zen and release
# Firefox install only signed ones). The AMO API key's JWT issuer and secret, from
# https://addons.mozilla.org/developers/addon/api/key/. Without them the .xpi is unsigned.
# See apps/extension/README.md.
# WEB_EXT_API_KEY=pass://Stash/AMO/jwt_issuer
# WEB_EXT_API_SECRET=pass://Stash/AMO/jwt_secret

# Planned: these vault items are not created yet. Once they exist, uncomment and make the
# item title match the vault exactly (case-sensitive).
# SESSION_SECRET=pass://Stash/app/session_secret
# Batch import (apps/migrate): the api's URL and an API token from `POST /tokens`.
# STASH_API_URL=pass://Stash/migrate/api_url
# STASH_API_TOKEN=pass://Stash/migrate/api_token
