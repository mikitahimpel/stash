# Proton Pass references only (vault "Stash"); never put real values here.
# Copy to .env (gitignored) and run: PROTON_PASS_AGENT_REASON="<reason>" pp run --env-file .env -- <cmd>
ANTHROPIC_API_KEY=pass://Stash/Anthropic/api_key
# Workers AI embeddings smoke test (`smoke:embed`, docs/enrichment-smoke.md) and deploys.
CLOUDFLARE_ACCOUNT_ID=pass://Stash/Cloudflare/account_id
CLOUDFLARE_API_TOKEN=pass://Stash/Cloudflare/api_token

# `pnpm dev:api` (alchemy dev) needs none of these. Alchemy auto-loads this .env, but the shell
# environment wins, so run deploys through `pp run` and never pass `--env-file .env` to alchemy.
# See docs/alchemy.md.

# Not a secret: extra hosts (comma-separated) the web dev/preview server accepts, for opening
# `pnpm dev:web` by hostname from another machine. Unset keeps Vite's default. See apps/web/CLAUDE.md.
# STASH_DEV_ALLOWED_HOSTS=

# Planned: these vault items are not created yet. Once they exist, uncomment and make the
# item title match the vault exactly (case-sensitive).
# GITHUB_OAUTH_CLIENT_ID=pass://Stash/github-oauth/client_id
# GITHUB_OAUTH_CLIENT_SECRET=pass://Stash/github-oauth/client_secret
# SESSION_SECRET=pass://Stash/app/session_secret
# Batch import (apps/migrate): the api's URL and an API token from `POST /tokens`.
# STASH_API_URL=pass://Stash/migrate/api_url
# STASH_API_TOKEN=pass://Stash/migrate/api_token
# MCP server (apps/mcp): the API token it calls the api with, passed to the Worker as API_TOKEN.
# STASH_MCP_API_TOKEN=pass://Stash/mcp/api_token
