{
  "extends": "@stash/config-tsconfig/web.json",
  "compilerOptions": {
    "types": ["vite/client"]
  },
  "include": ["src", "test", "scripts", "vite.config.ts", "vitest.config.ts"],
  "vueCompilerOptions": {
    // `@stash/web-ui` marks its parts with data-slot, which strictTemplates rejects by default.
    "strictTemplates": true,
    "dataAttributes": ["data-*"]
  }
}
