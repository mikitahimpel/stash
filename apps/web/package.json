{
  "name": "@stash/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {},
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "screenshots": "playwright install chromium && node scripts/screenshots.ts",
    "lint": "oxlint .",
    "format:check": "oxfmt --check .",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@effect/atom-vue": "catalog:",
    "@lucide/vue": "catalog:",
    "@stash/web-api-client": "workspace:*",
    "@stash/web-auth": "workspace:*",
    "@stash/web-links": "workspace:*",
    "@stash/web-open-tabs": "workspace:*",
    "@stash/web-platform": "workspace:*",
    "@stash/web-search": "workspace:*",
    "@stash/web-settings": "workspace:*",
    "@stash/web-ui": "workspace:*",
    "effect": "catalog:",
    "vue": "catalog:",
    "vue-router": "catalog:"
  },
  "devDependencies": {
    "@stash/config-tsconfig": "workspace:*",
    "@stash/config-vitest": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vue/test-utils": "catalog:",
    "happy-dom": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "playwright": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:vue",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue-tsc": "catalog:"
  }
