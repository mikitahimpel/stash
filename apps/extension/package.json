{
  "name": "@stash/extension",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {},
  "scripts": {
    "dev": "wxt --browser firefox --host 0.0.0.0",
    "build": "wxt zip --browser firefox",
    "lint": "oxlint .",
    "format:check": "oxfmt --check .",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@stash/contracts-api": "workspace:*",
    "@stash/ext-device-commands": "workspace:*",
    "@stash/ext-platform": "workspace:*",
    "effect": "catalog:",
    "vue": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@stash/config-tsconfig": "workspace:*",
    "@types/firefox-webext-browser": "catalog:",
    "@wxt-dev/module-vue": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:vue",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue-tsc": "catalog:",
    "wxt": "catalog:"
  }
}
