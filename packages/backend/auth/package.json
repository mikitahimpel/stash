{
  "name": "@stash/backend-auth",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./api-token-secret": "./src/api-tokens/api-token-secret.ts",
    "./api-tokens-repo": "./src/api-tokens/api-tokens-repo.ts",
    "./create-api-token": "./src/api-tokens/create-api-token.ts",
    "./list-api-tokens": "./src/api-tokens/list-api-tokens.ts",
    "./revoke-api-token": "./src/api-tokens/revoke-api-token.ts",
    "./tokens-handlers": "./src/api-tokens/tokens-handlers.ts",
    "./authorization-live": "./src/authorization/authorization-live.ts",
    "./session-verifier": "./src/authorization/session-verifier.ts",
    "./auth-handlers": "./src/github-oauth/auth-handlers.ts",
    "./github-client": "./src/github-oauth/github-client.ts",
    "./oauth-state": "./src/github-oauth/oauth-state.ts",
    "./sessions-repo": "./src/sessions/sessions-repo.ts",
    "./session-token": "./src/sessions/session-token.ts",
    "./start-session": "./src/sessions/start-session.ts",
    "./end-session": "./src/sessions/end-session.ts",
    "./session-verifier-live": "./src/sessions/session-verifier-live.ts"
