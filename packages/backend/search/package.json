{
  "name": "@stash/backend-search",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./hybrid-search": "./src/hybrid-search.ts",
    "./keyword-search": "./src/keyword-search.ts",
    "./search-handlers": "./src/search-handlers.ts",
    "./search-repo": "./src/search-repo.ts",
    "./search-service": "./src/search-service.ts",
    "./semantic-search": "./src/semantic-search.ts"
  },
  "scripts": {
    "lint": "oxlint .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p test/tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@stash/backend-platform": "workspace:*",
    "@stash/contracts-api": "workspace:*",
    "@stash/contracts-domain": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@effect/vitest": "catalog:",
    "@stash/config-tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
