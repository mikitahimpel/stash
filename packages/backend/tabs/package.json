{
  "name": "@stash/backend-tabs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./device-access": "./src/device-access.ts",
    "./archive-tab": "./src/archive-tab.ts",
    "./tabs-handlers": "./src/tabs-handlers.ts",
    "./devices-handlers": "./src/devices-handlers.ts",
    "./devices-repo": "./src/devices/devices-repo.ts",
    "./register-device": "./src/devices/register-device.ts",
    "./list-devices": "./src/devices/list-devices.ts",
    "./open-tabs-repo": "./src/snapshots/open-tabs-repo.ts",
    "./replace-tabs-snapshot": "./src/snapshots/replace-tabs-snapshot.ts",
    "./list-open-tabs": "./src/snapshots/list-open-tabs.ts",
